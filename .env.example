ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5

# Local dev: mongodb://localhost:27017
# Cloud Run: your MongoDB Atlas connection string (see README deployment section)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=audiobook_review

# sherpa_onnx | google | xtts
TTS_BACKEND=sherpa_onnx

# Local dev: leave unset to store uploads/audio under ./jobs on local disk.
# Cloud Run: set to a GCS bucket name to store uploads/audio there instead
# (Cloud Run's own filesystem is wiped on every restart).
GCS_BUCKET=

# Local-disk fallback directory, only used when GCS_BUCKET is unset
AUDIO_ROOT=./jobs
